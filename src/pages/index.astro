---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="首頁"
  description="數位敘事力期刊是專注於教育科技與數位敘事的知識分享平台，由吳奇老師創辦，提供最新的AI教學工具、研究成果與實踐經驗。"
>
  <Header />

  <main class="pt-20">
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-navy-500 via-primary-600 to-secondary-600">
      <!-- Animated Background -->
      <div class="absolute inset-0 opacity-20">
        <div class="absolute top-20 left-20 w-72 h-72 bg-white rounded-full mix-blend-multiply filter blur-xl animate-pulse"></div>
        <div class="absolute top-40 right-20 w-72 h-72 bg-primary-300 rounded-full mix-blend-multiply filter blur-xl animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute bottom-20 left-1/2 w-72 h-72 bg-secondary-300 rounded-full mix-blend-multiply filter blur-xl animate-pulse" style="animation-delay: 4s;"></div>
      </div>

      <!-- Content -->
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 animate-fade-in">
          數位敘事力期刊
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-4 animate-fade-in" style="animation-delay: 0.2s;">
          Journal of Digital Narrative
        </p>
        <p class="text-2xl md:text-3xl font-semibold text-white mb-12 animate-fade-in" style="animation-delay: 0.4s;">
          用科技說故事，以敘事賦能教育
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in" style="animation-delay: 0.6s;">
          <a
            href="/about"
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-navy-500 font-bold rounded-lg hover:bg-gray-100 hover:scale-105 transition-all shadow-lg"
          >
            認識吳奇老師
            <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="/articles"
            class="inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-white text-white font-bold rounded-lg hover:bg-white hover:text-navy-500 transition-all"
          >
            探索文章專欄
          </a>
        </div>

        <!-- Scroll Indicator -->
        <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </div>
    </section>

    <!-- Introduction Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-4xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            AI教育先行者的知識分享平台
          </h2>
          <p class="text-xl text-gray-600 leading-relaxed">
            由國文教師吳奇創辦，致力於連結科技與人文，透過系統性分享最新的AI教育工具、
            前瞻觀點與實際應用方法，成為所有教育工作者的數位智庫。
          </p>
        </div>

        <!-- Statistics -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 animate-on-scroll">
          <div class="text-center p-6 bg-gradient-to-br from-primary-50 to-primary-100 rounded-xl">
            <div class="text-5xl font-bold text-primary-600 mb-2">100+</div>
            <div class="text-gray-700 font-medium">演講與工作坊</div>
          </div>
          <div class="text-center p-6 bg-gradient-to-br from-secondary-50 to-secondary-100 rounded-xl">
            <div class="text-5xl font-bold text-secondary-600 mb-2">6</div>
            <div class="text-gray-700 font-medium">主題領域</div>
          </div>
          <div class="text-center p-6 bg-gradient-to-br from-accent-50 to-accent-100 rounded-xl">
            <div class="text-5xl font-bold text-accent-600 mb-2">1.5K+</div>
            <div class="text-gray-700 font-medium">社群追蹤者</div>
          </div>
          <div class="text-center p-6 bg-gradient-to-br from-primary-50 to-secondary-100 rounded-xl">
            <div class="text-5xl font-bold bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent mb-2">∞</div>
            <div class="text-gray-700 font-medium">持續創新</div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Wu Qi Section -->
    <section class="py-20 bg-gradient-to-br from-gray-50 to-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Image -->
          <div class="animate-on-scroll">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-primary-500 to-secondary-500 rounded-2xl transform rotate-3"></div>
              <div class="relative bg-white p-2 rounded-2xl shadow-xl">
                <div class="aspect-[4/5] bg-gradient-to-br from-gray-200 to-gray-300 rounded-xl flex items-center justify-center">
                  <svg class="w-32 h-32 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="animate-on-scroll">
            <div class="inline-block px-4 py-2 bg-primary-100 text-primary-600 rounded-full text-sm font-semibold mb-4">
              AI教育先行者
            </div>
            <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
              吳奇老師
            </h2>
            <p class="text-xl text-gray-600 mb-8 leading-relaxed">
              一位致力於連結科技與人文的國文老師，不僅在課堂上傳授文學之美，
              更走在時代前端，將AI人工智慧的強大能量注入教學實踐。
            </p>

            <!-- Credentials -->
            <div class="space-y-4 mb-8">
              <div class="flex items-start space-x-3">
                <svg class="w-6 h-6 text-primary-500 flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <div class="font-semibold text-gray-900">國立台灣師範大學</div>
                  <div class="text-gray-600">華語文教學研究所</div>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <svg class="w-6 h-6 text-primary-500 flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <div class="font-semibold text-gray-900">Google Certified Trainer</div>
                  <div class="text-gray-600">Google 認證講師</div>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <svg class="w-6 h-6 text-primary-500 flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <div class="font-semibold text-gray-900">桃園市大華中學</div>
                  <div class="text-gray-600">國文科教師</div>
                </div>
              </div>
            </div>

            <a
              href="/about"
              class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-primary-500 to-secondary-500 text-white font-semibold rounded-lg hover:shadow-lg hover:-translate-y-0.5 transition-all"
            >
              了解更多
              <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Topics Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            核心主題領域
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            涵蓋教育科技的各個面向，從AI工具到教學實踐，為教育工作者提供全方位的知識支援
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Topic Card 1 -->
          <div class="group p-8 bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl hover:shadow-xl hover:-translate-y-2 transition-all cursor-pointer animate-on-scroll">
            <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">AI與教育科技</h3>
            <p class="text-gray-600 leading-relaxed">
              生成式AI、教學工具、自動化應用，探索AI如何革新教育現場
            </p>
          </div>

          <!-- Topic Card 2 -->
          <div class="group p-8 bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl hover:shadow-xl hover:-translate-y-2 transition-all cursor-pointer animate-on-scroll">
            <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">數位工具應用</h3>
            <p class="text-gray-600 leading-relaxed">
              EdTech工具評測、使用指南，幫助教師找到最適合的數位解決方案
            </p>
          </div>

          <!-- Topic Card 3 -->
          <div class="group p-8 bg-gradient-to-br from-green-50 to-green-100 rounded-2xl hover:shadow-xl hover:-translate-y-2 transition-all cursor-pointer animate-on-scroll">
            <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">華語文教學</h3>
            <p class="text-gray-600 leading-relaxed">
              數位化華語教學實踐，結合科技與語文教育的創新方法
            </p>
          </div>

          <!-- Topic Card 4 -->
          <div class="group p-8 bg-gradient-to-br from-orange-50 to-orange-100 rounded-2xl hover:shadow-xl hover:-translate-y-2 transition-all cursor-pointer animate-on-scroll">
            <div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">創新教學實踐</h3>
            <p class="text-gray-600 leading-relaxed">
              教學方法、課程設計，分享第一線教師的實戰經驗
            </p>
          </div>

          <!-- Topic Card 5 -->
          <div class="group p-8 bg-gradient-to-br from-pink-50 to-pink-100 rounded-2xl hover:shadow-xl hover:-translate-y-2 transition-all cursor-pointer animate-on-scroll">
            <div class="w-16 h-16 bg-gradient-to-br from-pink-500 to-pink-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">教育研究</h3>
            <p class="text-gray-600 leading-relaxed">
              學術研究成果、趨勢分析，深入探討教育科技的理論基礎
            </p>
          </div>

          <!-- Topic Card 6 -->
          <div class="group p-8 bg-gradient-to-br from-indigo-50 to-indigo-100 rounded-2xl hover:shadow-xl hover:-translate-y-2 transition-all cursor-pointer animate-on-scroll">
            <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">跨領域整合</h3>
            <p class="text-gray-600 leading-relaxed">
              跨學科教學應用，展現科技與人文的完美結合
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-br from-navy-500 to-primary-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
            開始您的AI教育探索之旅
          </h2>
          <p class="text-xl text-white/90 mb-12 max-w-3xl mx-auto">
            追蹤我們的社群平台，獲取最新的教育科技資訊、工具推薦與教學實踐分享
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://www.instagram.com/journal_of_digital_narrative/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-8 py-4 bg-white text-navy-500 font-bold rounded-lg hover:bg-gray-100 hover:scale-105 transition-all shadow-lg"
            >
              <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              追蹤 Instagram
            </a>
            <a
              href="https://www.facebook.com/數位敘事力期刊Journal-of-Digital-Narrative"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-white text-white font-bold rounded-lg hover:bg-white hover:text-navy-500 transition-all"
            >
              <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              加入 Facebook
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
